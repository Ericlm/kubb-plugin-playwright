{
  "name": "kubb-plugin-playwright",
  "version": "0.1.0",
  "description": "Generate typed Playwright API request helpers from OpenAPI with Kubb.",
  "keywords": [
    "api-testing",
    "codegen",
    "e2e-testing",
    "kubb",
    "kubb-plugin",
    "openapi",
    "playwright",
    "typescript"
  ],
  "homepage": "https://kubb.dev/extensions/ericlm/kubb-plugin-playwright",
  "bugs": {
    "url": "https://github.com/Ericlm/kubb-plugin-playwright/issues"
  },
  "license": "MIT",
  "author": "Éric Le Maître (https://github.com/Ericlm)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ericlm/kubb-plugin-playwright.git"
  },
  "files": [
    "dist",
    "kubb-extension.json",
    "docs",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./kubb-extension.json": "./kubb-extension.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "generate:petstore": "kubb generate --config tests/petstore/kubb.config.ts",
    "test": "pnpm generate:petstore && vitest run",
    "prepack": "pnpm build && pnpm test",
    "check:package": "node scripts/check-package.mjs",
    "changeset": "changeset"
  },
  "dependencies": {
    "@kubb/kit": "^5.15.3",
    "@kubb/plugin-ts": "^5.4.0",
    "@kubb/renderer-jsx": "^5.15.3"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@kubb/adapter-oas": "^5.15.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "kubb": "^5.15.3",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "@playwright/test": "^1.63.0",
    "kubb": "^5.15.0"
  },
  "engines": {
    "node": ">=22.22"
  },
  "packageManager": "pnpm@11.24.0"
}
