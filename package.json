{
  "name": "kubb-plugin-playwright",
  "version": "0.1.0",
  "description": "Generate typed Playwright API request helpers from OpenAPI with Kubb.",
  "license": "MIT",
  "author": "Éric Le Maître",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "generate:petstore": "kubb generate --config tests/petstore/kubb.config.ts",
    "test": "pnpm generate:petstore && vitest run"
  },
  "engines": {
    "node": ">=22.22"
  },
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@kubb/kit": "^5.15.3",
    "@kubb/plugin-ts": "^5.4.0",
    "@kubb/renderer-jsx": "^5.15.3"
  },
  "devDependencies": {
    "@kubb/adapter-oas": "^5.15.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "kubb": "^5.15.3",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
