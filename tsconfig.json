{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "ES2025.Collection", "ES2025.Iterator", "ESNext.Array", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "noErrorTruncation": true,

    "jsx": "react-jsx",
    "jsxImportSource": "@kubb/renderer-jsx",
    "types": ["node"]
  },
  "include": ["src/**/*", "tests/**/*", "./package.json", "./kubb-extension.json", "./tsdown.config.ts", "./vitest.config.ts"],
  "exclude": ["node_modules", "dist", "coverage", "tests/**/gen/**"]
}
